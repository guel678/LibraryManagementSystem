<Window x:Class="LibraryManagementSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Management System Login"
        Height="430"
        Width="540"
        MinHeight="430"
        MinWidth="540"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="LoginFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,0,0,5" />
        </Style>
        <Style x:Key="LoginInputFrame" TargetType="Border">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="LoginBareTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="LoginBarePasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource CardBrush}" Margin="0">
        <Border Padding="28,22,28,24"
                Background="{StaticResource CardBrush}"
                BorderThickness="0"
                CornerRadius="0"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">
            <StackPanel Width="360"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Height="1"
                            Background="{StaticResource PanelBorderBrush}"
                            Opacity="0.55"
                            VerticalAlignment="Center"
                            Margin="18,0,12,0" />
                    <Grid Grid.Column="1">
                        <TextBlock Text="&#xE82D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="32"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Border Width="7"
                                Height="13"
                                Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="16,0,0,3" />
                    </Grid>
                    <Border Grid.Column="2"
                            Height="1"
                            Background="{StaticResource PanelBorderBrush}"
                            Opacity="0.55"
                            VerticalAlignment="Center"
                            Margin="12,0,18,0" />
                </Grid>

                <TextBlock Text="Library Management System"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,5" />
                <TextBlock x:Name="ModeText"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <Border Width="58"
                        Height="2"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="2"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16" />

                <TextBlock Text="Username" Style="{StaticResource LoginFieldLabel}" />
                <Border Style="{StaticResource LoginInputFrame}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource WatermarkBrush}"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="UsernameBox"
                                 Grid.Column="1"
                                 Style="{StaticResource LoginBareTextBox}"
                                 TextChanged="UsernameBox_TextChanged"
                                 GotKeyboardFocus="UsernameBox_GotKeyboardFocus"
                                 LostKeyboardFocus="UsernameBox_LostKeyboardFocus"
                                 ToolTip="Enter your username" />
                        <TextBlock x:Name="UsernamePlaceholder"
                                   Grid.Column="1"
                                   Text="Enter username"
                                   Foreground="{StaticResource WatermarkBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <TextBlock Text="Password" Style="{StaticResource LoginFieldLabel}" />
                <Border Style="{StaticResource LoginInputFrame}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource WatermarkBrush}"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <PasswordBox x:Name="PasswordBox"
                                     Grid.Column="1"
                                     Style="{StaticResource LoginBarePasswordBox}"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     GotKeyboardFocus="PasswordBox_GotKeyboardFocus"
                                     LostKeyboardFocus="PasswordBox_LostKeyboardFocus"
                                     ToolTip="Enter your password" />
                        <TextBlock x:Name="PasswordPlaceholder"
                                   Grid.Column="1"
                                   Text="Enter password"
                                   Foreground="{StaticResource WatermarkBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap"
                           MinHeight="16"
                           Margin="4,6,4,2" />
                <Button x:Name="LoginButton"
                        Content="Login"
                        IsDefault="True"
                        Click="Login_Click"
                        Margin="4,8,4,0"
                        Background="{StaticResource PrimaryBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        Foreground="{StaticResource HeaderTextBrush}"
                        Width="165"
                        Height="36"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
