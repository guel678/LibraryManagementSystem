<Window x:Class="LibraryManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding WindowTitle}"
        Height="800"
        Width="1280"
        MinHeight="700"
        MinWidth="1120"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="{StaticResource PageBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="24,18">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="{DynamicResource AppTitleText}"
                           Foreground="{StaticResource HeaderTextBrush}"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <Border DockPanel.Dock="Right"
                        Background="{StaticResource HeaderChipBrush}"
                        BorderBrush="{StaticResource HeaderChipBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10,5"
                        Margin="24,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="18"
                                Height="18"
                                CornerRadius="9"
                                Background="{StaticResource CardBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding AccountText}"
                                   Foreground="{StaticResource HeaderTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <TabControl Margin="16" Style="{StaticResource MainNavigationTabs}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource DashboardText}" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="8"
                                Padding="18"
                                Margin="0,0,0,16">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource DashboardText}"
                                               Style="{StaticResource SectionTitle}"
                                               FontSize="32" />
                                    <TextBlock Text="{Binding WelcomeMessage}"
                                               Style="{StaticResource SectionSubtitle}"
                                               FontSize="14" />
                                </StackPanel>
                                <Border DockPanel.Dock="Right"
                                        Background="{StaticResource InputBackgroundBrush}"
                                        BorderBrush="{StaticResource TableGridLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,7"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE787;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="14"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentDateText}"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="-8,0,-8,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource DashboardStatCard}" Grid.Column="0">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Style="{StaticResource DashboardIconBadge}">
                                            <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource HeaderTextBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource BookTitlesText}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding BookTitles}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource UniqueCatalogRecordsText}" Style="{StaticResource StatLink}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource DashboardStatCard}" Grid.Column="1">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Style="{StaticResource DashboardIconBadge}">
                                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource HeaderTextBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource TotalCopiesText}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding TotalBooks}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource PhysicalBooksOwnedText}" Style="{StaticResource StatLink}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource DashboardStatCard}" Grid.Column="2">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Style="{StaticResource DashboardIconBadge}">
                                            <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource HeaderTextBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource AvailableCopiesText}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding AvailableBooks}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource ReadyToBorrowText}" Style="{StaticResource StatLink}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource DashboardStatCard}" Grid.Column="3">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Style="{StaticResource DashboardIconBadge}">
                                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource HeaderTextBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource BorrowedCopiesText}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding OpenLoans}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource CurrentlyCheckedOutText}" Style="{StaticResource StatLink}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource DashboardStatCard}" Grid.Column="4">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Style="{StaticResource DashboardIconBadge}">
                                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource HeaderTextBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource ActivePatronsText}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding TotalPatrons}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource CanBorrowBooksText}" Style="{StaticResource StatLink}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource DashboardStatCard}" Grid.Column="5">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Style="{StaticResource DashboardIconBadge}" Background="{StaticResource AccentBrush}">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource HeaderTextBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource OverdueBooksText}" Style="{StaticResource StatLabel}" />
                                            <TextBlock Text="{Binding OverdueLoans}" Style="{StaticResource StatValue}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource NeedsAttentionText}" Style="{StaticResource StatLink}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource PanelCard}">
                            <DockPanel LastChildFill="True">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource BooksText}"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource RecentCatalogSnapshotText}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Books}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          MaxHeight="330">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource TitleHeaderText}" Binding="{Binding Title}" Width="2*" MinWidth="180" />
                                        <DataGridTextColumn Header="{DynamicResource AuthorHeaderText}" Binding="{Binding Author}" Width="1.3*" MinWidth="140" />
                                        <DataGridTextColumn Header="{DynamicResource GenreHeaderText}" Binding="{Binding Genre}" Width="*" MinWidth="110" />
                                        <DataGridTextColumn Header="{DynamicResource YearHeaderText}" Binding="{Binding PublishedYear}" Width="90" />
                                        <DataGridTextColumn Header="{DynamicResource CopiesHeaderText}" Binding="{Binding Quantity}" Width="90" />
                                        <DataGridTextColumn Header="{DynamicResource AvailableHeaderText}" Binding="{Binding AvailableCopies}" Width="100" />
                                        <DataGridTextColumn Header="{DynamicResource StatusHeaderText}" Binding="{Binding Availability}" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource CatalogText}" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource PanelCard}" Margin="8">
                    <DockPanel LastChildFill="True">
                        <Border Style="{StaticResource ToolbarPanel}" DockPanel.Dock="Top">
                            <WrapPanel VerticalAlignment="Center">
                                <StackPanel Style="{StaticResource ToolbarField}">
                                    <TextBlock Text="{DynamicResource SearchBooksText}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Width="320" Text="{Binding BookSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search title, author, ISBN, or genre" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource ToolbarField}">
                                    <TextBlock Text="{DynamicResource AvailabilityText}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Width="160" ItemsSource="{Binding AvailabilityOptions}" SelectedItem="{Binding AvailabilityFilter}" />
                                </StackPanel>
                                <Button Content="{DynamicResource AddText}" Command="{Binding AddBookCommand}" Style="{StaticResource ToolbarActionButton}" />
                                <Button Content="{DynamicResource SaveText}" Command="{Binding UpdateBookCommand}" Style="{StaticResource ToolbarActionButton}" />
                                <Button Content="{DynamicResource DeleteText}" Command="{Binding DeleteBookCommand}" Style="{StaticResource ToolbarActionButton}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" />
                            </WrapPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource TitleHeaderText}" Binding="{Binding Title}" Width="2.2*" MinWidth="170" />
                                <DataGridTextColumn Header="{DynamicResource AuthorHeaderText}" Binding="{Binding Author}" Width="1.3*" MinWidth="130" />
                                <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="1.2*" MinWidth="125" />
                                <DataGridTextColumn Header="{DynamicResource GenreHeaderText}" Binding="{Binding Genre}" Width="*" MinWidth="105" />
                                <DataGridTextColumn Header="{DynamicResource PublisherHeaderText}" Binding="{Binding Publisher}" Width="1.1*" MinWidth="120" />
                                <DataGridTextColumn Header="{DynamicResource DescriptionHeaderText}" Binding="{Binding Description}" Width="1.5*" MinWidth="160" />
                                <DataGridTextColumn Header="{DynamicResource YearHeaderText}" Binding="{Binding PublishedYear}" Width="80" />
                                <DataGridTextColumn Header="{DynamicResource CopiesHeaderText}" Binding="{Binding Quantity}" Width="80" />
                                <DataGridTextColumn Header="{DynamicResource BorrowedHeaderText}" Binding="{Binding CheckedOutCount}" Width="96" IsReadOnly="True" />
                                <DataGridTextColumn Header="{DynamicResource AvailableHeaderText}" Binding="{Binding AvailableCopies}" Width="96" IsReadOnly="True" />
                                <DataGridTextColumn Header="{DynamicResource StatusHeaderText}" Binding="{Binding Availability}" Width="120" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource PatronsText}" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource PanelCard}" Margin="8">
                    <DockPanel LastChildFill="True">
                        <Border Style="{StaticResource ToolbarPanel}" DockPanel.Dock="Top">
                            <WrapPanel VerticalAlignment="Center">
                                <StackPanel Style="{StaticResource ToolbarField}">
                                    <TextBlock Text="{DynamicResource SearchPatronsText}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Width="320" Text="{Binding PatronSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search name, membership ID, or email" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource ToolbarField}">
                                    <TextBlock Text="{DynamicResource MembershipStatusText}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Width="170" ItemsSource="{Binding MembershipOptions}" SelectedItem="{Binding MembershipFilter}" />
                                </StackPanel>
                                <Button Content="{DynamicResource AddText}" Command="{Binding AddPatronCommand}" Style="{StaticResource ToolbarActionButton}" />
                                <Button Content="{DynamicResource SaveText}" Command="{Binding UpdatePatronCommand}" Style="{StaticResource ToolbarActionButton}" />
                                <Button Content="{DynamicResource DeleteText}" Command="{Binding DeletePatronCommand}" Style="{StaticResource ToolbarActionButton}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" />
                            </WrapPanel>
                        </Border>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding Patrons}" SelectedItem="{Binding SelectedPatron}" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource FullNameHeaderText}" Binding="{Binding FullName}" Width="1.7*" MinWidth="160" />
                                <DataGridTextColumn Header="{DynamicResource MembershipIdHeaderText}" Binding="{Binding MembershipId}" Width="130" />
                                <DataGridTextColumn Header="{DynamicResource EmailHeaderText}" Binding="{Binding Email}" Width="1.4*" MinWidth="160" />
                                <DataGridTextColumn Header="{DynamicResource PhoneHeaderText}" Binding="{Binding PhoneNumber}" Width="125" />
                                <DataGridTextColumn Header="{DynamicResource AddressHeaderText}" Binding="{Binding Address}" Width="1.2*" MinWidth="140" />
                                <DataGridTextColumn Header="{DynamicResource BirthDateHeaderText}" Binding="{Binding DateOfBirth, StringFormat=d}" Width="110" />
                                <DataGridTemplateColumn Header="{DynamicResource TypeHeaderText}" Width="132">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.MembershipTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      Style="{StaticResource TableComboBox}"
                                                      SelectedItem="{Binding MembershipType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{DynamicResource StatusHeaderText}" Width="118">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.PatronStatuses, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      Style="{StaticResource TableComboBox}"
                                                      SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                            <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource SelectedPatronHistoryText}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8" />
                                    <DataGrid ItemsSource="{Binding PatronHistory}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource BookHeaderText}" Binding="{Binding BookTitle}" Width="2*" />
                                            <DataGridTextColumn Header="{DynamicResource CheckoutHeaderText}" Binding="{Binding CheckoutDate, StringFormat={}{0:MMM dd, yyyy}}" Width="130" />
                                            <DataGridTextColumn Header="{DynamicResource DueHeaderText}" Binding="{Binding DueDate, StringFormat={}{0:MMM dd, yyyy}}" Width="130" />
                                            <DataGridTextColumn Header="{DynamicResource ReturnedHeaderText}" Binding="{Binding DisplayReturnDate}" Width="130" />
                                            <DataGridTextColumn Header="{DynamicResource FineHeaderText}" Binding="{Binding DisplayFine}" Width="100" />
                                            <DataGridTextColumn Header="{DynamicResource StatusHeaderText}" Binding="{Binding Status}" Width="120" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource TransactionsText}" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="8,6,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource TransactionsText}"
                                   Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{DynamicResource TransactionsSubtitleText}"
                                   Style="{StaticResource SectionSubtitle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            MaxWidth="980"
                            Style="{StaticResource TransactionFormCard}"
                            HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <TextBlock Text="&#xE82D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="16"
                                               Margin="0,0,9,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource BookToCheckoutText}" Style="{StaticResource TransactionFieldLabel}" Margin="0" />
                                </StackPanel>
                                <ComboBox Height="42"
                                          FontSize="13"
                                          Margin="0"
                                          ItemsSource="{Binding Books}"
                                          SelectedItem="{Binding SelectedCheckoutBook}"
                                          ToolTip="Select a book to checkout">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <TextBlock Text="&#xE77B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="16"
                                               Margin="0,0,9,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource PatronText}" Style="{StaticResource TransactionFieldLabel}" Margin="0" />
                                </StackPanel>
                                <ComboBox Height="42"
                                          FontSize="13"
                                          Margin="0"
                                          ItemsSource="{Binding Patrons}"
                                          SelectedItem="{Binding SelectedCheckoutPatron}"
                                          ToolTip="Select a patron">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FullName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <TextBlock Text="&#xE787;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="16"
                                               Margin="0,0,9,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource CheckoutDateText}" Style="{StaticResource TransactionFieldLabel}" Margin="0" />
                                </StackPanel>
                                <DatePicker SelectedDate="{Binding CheckoutDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedDateFormat="Short"
                                            Height="42"
                                            FontSize="13"
                                            Margin="0"
                                            ToolTip="Choose the checkout date" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <TextBlock Text="&#xE787;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="16"
                                               Margin="0,0,9,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource DueDateText}" Style="{StaticResource TransactionFieldLabel}" Margin="0" />
                                </StackPanel>
                                <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedDateFormat="Short"
                                            Height="42"
                                            FontSize="13"
                                            Margin="0"
                                            ToolTip="Choose the due date" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                    <TextBlock Text="&#xE823;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="16"
                                               Margin="0,0,9,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource BorrowedBooksText}" Style="{StaticResource TransactionFieldLabel}" Margin="0" />
                                </StackPanel>
                                <ComboBox Height="42"
                                          FontSize="13"
                                          Margin="0"
                                          ItemsSource="{Binding OpenTransactions}"
                                          SelectedItem="{Binding SelectedOpenTransaction}"
                                          ToolTip="Books currently borrowed by the selected patron">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BookTitle}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Grid Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding CheckoutCommand}"
                                        Style="{StaticResource TransactionActionButton}"
                                        Background="{StaticResource AccentBrush}"
                                        BorderBrush="{StaticResource AccentBrush}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,9,0" />
                                        <TextBlock Text="{DynamicResource CheckoutText}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding ReturnCommand}"
                                        Style="{StaticResource TransactionActionButton}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,9,0" />
                                        <TextBlock Text="{DynamicResource ReturnText}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBox Grid.Row="2"
                             Width="340"
                             Height="40"
                             HorizontalAlignment="Left"
                             Style="{StaticResource WatermarkTextBox}"
                             Tag="Search transactions..."
                             Text="{Binding TransactionSearch, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search patron, book, or date"
                             Margin="0,0,0,10" />

                    <Border Grid.Row="3"
                            Background="{StaticResource InputBackgroundBrush}"
                            BorderBrush="{StaticResource TableGridLineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="0"
                            ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding Transactions}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  RowHeight="46"
                                  ColumnHeaderHeight="42"
                                  Background="{StaticResource InputBackgroundBrush}"
                                  AlternatingRowBackground="{StaticResource TableAltRowBrush}"
                                  RowBackground="{StaticResource InputBackgroundBrush}"
                                  BorderThickness="0">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="14,0" />
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource BookHeaderText}" Binding="{Binding BookTitle}" Width="1.5*" MinWidth="160" />
                                <DataGridTextColumn Header="{DynamicResource PatronText}" Binding="{Binding PatronName}" Width="1.25*" MinWidth="140" />
                                <DataGridTextColumn Header="{DynamicResource CheckoutHeaderText}" Binding="{Binding CheckoutDate, StringFormat={}{0:MMM d, yyyy}}" Width="120" />
                                <DataGridTextColumn Header="{DynamicResource DueHeaderText}" Binding="{Binding DueDate, StringFormat={}{0:MMM d, yyyy}}" Width="120" />
                                <DataGridTextColumn Header="{DynamicResource ReturnedHeaderText}" Binding="{Binding DisplayReturnDate}" Width="120" />
                                <DataGridTextColumn Header="{DynamicResource FineHeaderText}" Binding="{Binding DisplayFine}" Width="100" />
                                <DataGridTemplateColumn Header="{DynamicResource StatusHeaderText}" Width="135">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Normal">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Returned">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Overdue">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource ReportsText}" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24">
                        <Grid.Resources>
                            <Style x:Key="ReportDataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="RowHeight" Value="56" />
                                <Setter Property="ColumnHeaderHeight" Value="44" />
                                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
                                <Setter Property="AlternatingRowBackground" Value="{StaticResource TableAltRowBrush}" />
                                <Setter Property="RowBackground" Value="{StaticResource InputBackgroundBrush}" />
                            </Style>
                            <Style x:Key="ReportStatusChip" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </Grid.Resources>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,18">
                            <TextBlock Text="{DynamicResource ReportsText}"
                                       Style="{StaticResource SectionTitle}"
                                       FontSize="34" />
                            <TextBlock Text="{DynamicResource ReportsSubtitleText}"
                                       Style="{StaticResource SectionSubtitle}"
                                       FontSize="15" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource ToolbarPanel}" Padding="18" Margin="0,0,0,18">
                            <WrapPanel VerticalAlignment="Center">
                                <StackPanel Style="{StaticResource ToolbarField}">
                                    <TextBlock Text="{DynamicResource StartDateText}" Style="{StaticResource FieldLabel}" />
                                    <DatePicker Width="150" SelectedDate="{Binding ReportStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource ToolbarField}">
                                    <TextBlock Text="{DynamicResource EndDateText}" Style="{StaticResource FieldLabel}" />
                                    <DatePicker Width="150" SelectedDate="{Binding ReportEndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <Button Command="{Binding ExportReportCommand}" Style="{StaticResource ToolbarActionButton}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" MinWidth="142">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,9,0" />
                                        <TextBlock Text="{DynamicResource ExportReportText}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding BackupCommand}" Style="{StaticResource ToolbarActionButton}" MinWidth="142">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,9,0" />
                                        <TextBlock Text="{DynamicResource BackupDataText}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RestoreCommand}" Style="{StaticResource ToolbarActionButton}" MinWidth="142">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,9,0" />
                                        <TextBlock Text="{DynamicResource RestoreDataText}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="0">
                            <TabControl Margin="0" ItemContainerStyle="{StaticResource CompactTabItem}">
                                <TabItem Header="{DynamicResource OverdueTabText}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" BorderBrush="{StaticResource TableGridLineBrush}" BorderThickness="0,1,0,1" Padding="14,10">
                                            <TextBox Width="360"
                                                     HorizontalAlignment="Left"
                                                     Style="{StaticResource WatermarkTextBox}"
                                                     Tag="Search reports..."
                                                     Text="{Binding ReportSearch, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Search reports" />
                                        </Border>
                                        <Grid Grid.Row="1" Margin="14,12,14,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <DataGrid ItemsSource="{Binding OverdueReport}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ReportDataGrid}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{DynamicResource BookHeaderText}" Binding="{Binding BookTitle}" Width="2*" MinWidth="220" />
                                                    <DataGridTextColumn Header="{DynamicResource PatronText}" Binding="{Binding PatronName}" Width="1.2*" MinWidth="150" />
                                                    <DataGridTextColumn Header="{DynamicResource DueDateHeaderText}" Binding="{Binding DueDate, StringFormat={}{0:MMM dd, yyyy}}" Width="145" />
                                                    <DataGridTextColumn Header="{DynamicResource OverdueDaysHeaderText}" Binding="{Binding OverdueDays}" Width="145" />
                                                    <DataGridTextColumn Header="{DynamicResource FineHeaderText}" Binding="{Binding FineAmount, StringFormat=₱{0:N2}}" Width="120" />
                                                    <DataGridTemplateColumn Header="{DynamicResource StatusHeaderText}" Width="140">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Status}" Style="{StaticResource ReportStatusChip}" Foreground="{StaticResource DangerBrush}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                        <DockPanel Grid.Row="2" Margin="14,12,14,14">
                                            <TextBlock Text="{Binding ReportShowingText}" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{DynamicResource CheckedOutTabText}">
                                    <DataGrid ItemsSource="{Binding CheckedOutReport}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ReportDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource BookHeaderText}" Binding="{Binding BookTitle}" Width="2*" />
                                            <DataGridTextColumn Header="{DynamicResource PatronText}" Binding="{Binding PatronName}" Width="*" />
                                            <DataGridTextColumn Header="{DynamicResource DueDateHeaderText}" Binding="{Binding DueDate, StringFormat={}{0:MMM dd, yyyy}}" Width="145" />
                                            <DataGridTextColumn Header="{DynamicResource OverdueDaysHeaderText}" Binding="{Binding OverdueDays}" Width="145" />
                                            <DataGridTextColumn Header="{DynamicResource CurrentFineHeaderText}" Binding="{Binding FineAmount, StringFormat=₱{0:N2}}" Width="130" />
                                            <DataGridTextColumn Header="{DynamicResource StatusHeaderText}" Binding="{Binding Status}" Width="120" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="{DynamicResource PatronActivityTabText}">
                                    <DataGrid ItemsSource="{Binding PatronActivityReport}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ReportDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource PatronText}" Binding="{Binding PatronName}" Width="2*" />
                                            <DataGridTextColumn Header="{DynamicResource TotalCheckoutsHeaderText}" Binding="{Binding TotalCheckouts}" Width="150" />
                                            <DataGridTextColumn Header="{DynamicResource OpenOverduesHeaderText}" Binding="{Binding OpenOverdues}" Width="150" />
                                            <DataGridTextColumn Header="{DynamicResource TotalFinesHeaderText}" Binding="{Binding TotalFines, StringFormat=₱{0:N2}}" Width="140" />
                                            <DataGridTextColumn Header="{DynamicResource UnpaidFinesHeaderText}" Binding="{Binding UnpaidFines, StringFormat=₱{0:N2}}" Width="140" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="{DynamicResource HistoryTabText}">
                                    <DataGrid ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ReportDataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{DynamicResource BookHeaderText}" Binding="{Binding BookTitle}" Width="2*" />
                                            <DataGridTextColumn Header="{DynamicResource PatronText}" Binding="{Binding PatronName}" Width="*" />
                                            <DataGridTextColumn Header="{DynamicResource CheckoutHeaderText}" Binding="{Binding CheckoutDate, StringFormat={}{0:MMM dd, yyyy}}" Width="135" />
                                            <DataGridTextColumn Header="{DynamicResource DueHeaderText}" Binding="{Binding DueDate, StringFormat={}{0:MMM dd, yyyy}}" Width="135" />
                                            <DataGridTextColumn Header="{DynamicResource ReturnedHeaderText}" Binding="{Binding ReturnDate, StringFormat={}{0:MMM dd, yyyy}}" Width="135" />
                                            <DataGridTextColumn Header="{DynamicResource FineHeaderText}" Binding="{Binding FineAmount, StringFormat=₱{0:N2}}" Width="100" />
                                            <DataGridTextColumn Header="{DynamicResource StatusHeaderText}" Binding="{Binding Status}" Width="120" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="{DynamicResource FinesTabText}">
                                    <DockPanel Margin="0">
                                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource TableGridLineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                            <Button Command="{Binding MarkFinePaidCommand}" MinWidth="150" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,9,0" />
                                                    <TextBlock Text="{DynamicResource MarkPaidText}" />
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                        <DataGrid ItemsSource="{Binding Fines}" SelectedItem="{Binding SelectedFine}" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ReportDataGrid}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{DynamicResource PatronText}" Binding="{Binding PatronName}" Width="2*" />
                                                <DataGridTextColumn Header="{DynamicResource AmountHeaderText}" Binding="{Binding Amount, StringFormat=₱{0:N2}}" Width="140" />
                                                <DataGridTextColumn Header="{DynamicResource DateAppliedHeaderText}" Binding="{Binding DateApplied, StringFormat={}{0:MMM dd, yyyy}}" Width="150" />
                                                <DataGridTextColumn Header="{DynamicResource StatusHeaderText}" Binding="{Binding Status}" Width="120" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Visibility="{Binding UserManagementVisibility}">
                <TabItem.Header>
                    <StackPanel>
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource UsersText}" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8" IsEnabled="{Binding IsAdmin}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,18">
                            <TextBlock Text="{DynamicResource UsersText}"
                                       Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{DynamicResource UsersSubtitleText}"
                                       Style="{StaticResource SectionSubtitle}" />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,0,0,18" Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource UsernameText}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Height="42"
                                             Style="{StaticResource WatermarkTextBox}"
                                             Tag="Enter username"
                                             Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="{DynamicResource PasswordText}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Height="42"
                                             Style="{StaticResource WatermarkTextBox}"
                                             Tag="Enter password"
                                             Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="{DynamicResource RoleText}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Height="42"
                                              ItemsSource="{Binding UserRoles}"
                                              SelectedItem="{Binding NewUserRole}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="6">
                                    <TextBlock Text="{DynamicResource NewPasswordText}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Height="42"
                                             Style="{StaticResource WatermarkTextBox}"
                                             Tag="Enter new password"
                                             Text="{Binding ResetPasswordValue, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                                    <Button Command="{Binding AddUserCommand}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" MinWidth="160">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" />
                                            <TextBlock Text="{DynamicResource AddUserText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ResetPasswordCommand}" MinWidth="170">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" />
                                            <TextBlock Text="{DynamicResource ResetPasswordText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding UpdateUserCommand}" MinWidth="170">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" />
                                            <TextBlock Text="{DynamicResource SaveChangesText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DeleteUserCommand}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" MinWidth="140">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" />
                                            <TextBlock Text="{DynamicResource DeleteUserText}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource PanelCard}" Padding="18">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <TextBox Width="280"
                                             HorizontalAlignment="Left"
                                             Style="{StaticResource WatermarkTextBox}"
                                             Tag="Search users..."
                                             Text="{Binding UserSearch, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding UserFoundText}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontStyle="Italic" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource UsernameText}" Binding="{Binding Username}" Width="1.2*" MinWidth="160" />
                                        <DataGridTextColumn Header="{DynamicResource FullNameHeaderText}" Binding="{Binding FullName}" Width="1.8*" MinWidth="180" />
                                        <DataGridTextColumn Header="{DynamicResource RoleText}" Binding="{Binding Role}" Width="1.1*" MinWidth="130" />
                                        <DataGridCheckBoxColumn Header="{DynamicResource ActiveHeaderText}" Binding="{Binding IsActive}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource SettingsText}" FontSize="10" TextAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,18">
                            <TextBlock Text="{DynamicResource SettingsText}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{DynamicResource SettingsSubtitleText}" Style="{StaticResource SectionSubtitle}" />
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource PanelCard}" Padding="24" MaxWidth="900" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" MinWidth="420" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource LanguageText}"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Margin="4,0,4,12" />
                                    <ComboBox Width="220"
                                              HorizontalAlignment="Left"
                                              ItemsSource="{Binding LanguageOptions}"
                                              SelectedItem="{Binding PendingLanguage}" />
                                    <Button Content="{DynamicResource SaveSettingsText}"
                                            Command="{Binding SaveSettingsCommand}"
                                            Style="{StaticResource ToolbarActionButton}"
                                            MinWidth="160"
                                            Margin="4,18,4,0"
                                            HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding SettingsVisibilityNote}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="4,18,4,0" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{StaticResource TableGridLineBrush}"
                                        Margin="10,0,22,0" />

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{DynamicResource SystemInformationText}"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Margin="4,0,4,12" />
                                    <TextBlock Grid.Row="1" Text="{DynamicResource DatabaseText}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2"
                                             Text="{Binding DatabaseLocation, Mode=OneWay}"
                                             Style="{StaticResource SettingsInfoTextBox}" />
                                    <TextBlock Grid.Row="3" Text="{DynamicResource RuntimeText}" Style="{StaticResource FieldLabel}" Margin="4,12,4,2" />
                                    <TextBox Grid.Row="4"
                                             Text="{Binding RuntimeInfo, Mode=OneWay}"
                                             Style="{StaticResource SettingsInfoTextBox}" />
                                    <TextBlock Grid.Row="5"
                                               Text="{DynamicResource BackupRestoreNoteText}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontWeight="SemiBold"
                                               Margin="4,16,4,0"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
